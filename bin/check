#!/usr/bin/env bash
# Every check that gates a deploy. Exits non-zero if any fails.
#   bin/check         format check + fast build + tests
#   bin/check --site  tests only, on an already-built _site (CI, after its full production build;
#                     CI runs the format check earlier, before it edits _config.yml)
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ "${1:-}" != "--site" ]]; then
  npx --no-install prettier --check .
  # Development env and no image resizing: ~20 s instead of ~4 min.
  JEKYLL_ENV=development bundle exec jekyll build --config _config.yml,test/_config.fast.yml
fi
ruby test/check_images.rb
bundle exec ruby test/check_links.rb _site
