#!/usr/bin/env bash
# Every check that gates a deploy. Exits non-zero if any fails.
#   bin/check         format check + fast build (no image resizing) + tests
#   bin/check --site  format check + tests on an already-built _site (CI, after its full build)
set -euo pipefail
cd "$(dirname "$0")/.."

npx --no-install prettier --check .
if [[ "${1:-}" != "--site" ]]; then
  JEKYLL_ENV=production bundle exec jekyll build --config _config.yml,test/_config.fast.yml
fi
ruby test/check_images.rb
bundle exec ruby test/check_links.rb _site
